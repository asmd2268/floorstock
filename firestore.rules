rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active != false; }
    function pharmacy() { return active() && profile().role == 'pharmacy'; }
    function master() { return pharmacy() && profile().master == true; }
    function controlledOfficer() { return active() && profile().role == 'controlled_pharmacy'; }
    function warehouseOfficer() { return active() && profile().role == 'warehouse'; }

    match /users/{uid} {
      allow read: if active();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if master();
      allow write: if false;
    }

    match /floorstock_state/{docId} {
      allow read: if active();

      allow write: if
        (docId == 'controlled_catalog' && controlledOfficer()) ||
        (docId.matches('controlled_list_.*') && controlledOfficer()) ||
        (docId.matches('controlled_stock_custody_.*') && controlledOfficer()) ||
        (docId == 'controlled_stock_warehouse' && warehouseOfficer()) ||
        (docId == 'controlled_moves' && (controlledOfficer() || warehouseOfficer())) ||
        (docId.matches('controlled_settings_.*') && (controlledOfficer() || pharmacy())) ||
        (!docId.matches('controlled_.*') && active() &&
          profile().role != 'controlled_pharmacy' &&
          profile().role != 'warehouse');
    }

    match /public_controlled_expiry/{deptId} {
      allow read: if true;
      allow write: if active() && (profile().role == 'controlled_pharmacy' || profile().role == 'pharmacy');
    }

    match /public_expiry/{deptId} {
      allow read: if true;
      allow write: if active() &&
        profile().role != 'controlled_pharmacy' &&
        profile().role != 'warehouse';
    }

    match /{document=**} {
      allow read: if active();
      allow write: if false;
    }
  }
}
