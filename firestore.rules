rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Operational application state.
    // This intentionally allows any authenticated Floorstock user to read/write,
    // removing role/profile mismatches that were blocking controlled-stock restore.
    match /floorstock_state/{docId} {
      allow read, write: if signedIn();
    }

    match /public_expiry/{deptId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /public_controlled_expiry/{deptId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /audit_logs/{logId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
