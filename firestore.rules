rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() { return signedIn() && profile().active != false; }

    function isPharmacy()         { return active() && profile().role == 'pharmacy'; }
    function isMaster()           { return isPharmacy() && profile().master == true; }
    function isControlledOfficer(){ return active() && profile().role == 'controlled_pharmacy'; }
    function isWarehouseOfficer() { return active() && profile().role == 'warehouse'; }

    match /users/{uid} {
      allow read: if active();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /floorstock_state/{docId} {
      allow read: if active();

      allow write: if
        // ── Pharmacy manager: full access to everything ──────────────────
        isPharmacy() ||

        // ── Warehouse officer ────────────────────────────────────────────
        (isWarehouseOfficer() && (
          docId == 'controlled_catalog'              ||
          docId == 'controlled_warehouse'            ||
          docId == 'controlled_moves'                ||
          docId == 'controlled_alert_days'           ||
          docId == 'controlled_master_stock_seed_v4'
        )) ||

        // ── Controlled-pharmacy officer ──────────────────────────────────
        (isControlledOfficer() && (
          docId == 'controlled_catalog'              ||
          docId == 'controlled_pharmacy_stock'       ||
          docId.matches('controlled_dept_list_.*')   ||
          docId.matches('controlled_settings_.*')    ||
          docId == 'controlled_alert_days'           ||
          docId == 'controlled_moves'                ||
          docId == 'controlled_department_seed_v2'   ||
          docId == 'controlled_master_stock_seed_v4'
        )) ||

        // ── Regular department / custodian users ─────────────────────────
        (!docId.matches('controlled_.*') &&
          active() &&
          profile().role != 'controlled_pharmacy' &&
          profile().role != 'warehouse');
    }

    match /public_expiry/{deptId} {
      allow read: if true;
      allow write: if active() &&
        profile().role != 'controlled_pharmacy' &&
        profile().role != 'warehouse';
    }

    match /public_controlled_expiry/{deptId} {
      allow read: if true;
      allow write: if isPharmacy() || isControlledOfficer();
    }

    match /{document=**} {
      allow read: if active();
      allow write: if false;
    }
  }
}
