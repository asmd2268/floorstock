rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    // Merges the exists()+get() pair used everywhere else in this file into
    // a single get(), using .get('active', false) so a genuinely missing
    // profile document safely evaluates to false instead of erroring —
    // Firestore's rules get() on a nonexistent path returns a snapshot whose
    // .data access errors, but .data.get(field, default) on that snapshot
    // does not. That reduction alone (95/95, verified before adding the
    // claims check below) was what gave this the headroom the first,
    // reverted attempt at converting activeUser() didn't have.
    function activeUser() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.get('active', false) == true
        : (signedIn() && get(userPath()).data.get('active', false) == true);
    }

    // Phase 2b, narrowed after a full-conversion attempt regressed 4 tests
    // to the exact 1000-expression limit this was meant to prevent: touching
    // activeUser()/masterUser()/departmentId()/tenantId() too multiplied a
    // small per-call overhead across dozens of call sites in the largest
    // OR-chains and tipped them over. role() alone is touched here — it's
    // the single highest-value target (chained from almost every other role
    // check) and this stays a much smaller, isolated addition. A user with
    // no role claim yet falls straight through to the original get()-based
    // path with the ternary's condition check as the only added cost.
    function role() {
      return request.auth.token.get('role', null) != null
        ? (request.auth.token.get('active', false) == true ? request.auth.token.get('role', '') : '')
        : (activeUser() ? profile().get('role', '') : '');
    }

    // Only 2 call sites (here and the fulfillment_edit_settings_v1 check
    // below), so a dedicated helper is fine — the risk in the earlier failed
    // full-conversion attempt was fan-out across dozens of call sites, not
    // helper functions per se.
    function masterClaim() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.get('master', false) == true
        : (hasProfile() && profile().get('master', false) == true);
    }

    function masterUser() {
      return activeUser() && masterClaim()
        && role() in ['master', 'pharmacy', 'pharmacy_director'];
    }

    function pharmacyDirector() {
      return activeUser() && role() in ['master', 'pharmacy', 'pharmacy_director'];
    }

    function inpatientSupervisor() {
      return activeUser() && role() in ['inpatient_supervisor', 'inpatient_pharmacy_supervisor', 'inpatient pharmacy supervisor'];
    }

    function pharmacyStaff() {
      return activeUser() && role() == 'pharmacy_staff';
    }

    function controlledOfficer() {
      return activeUser() && role() == 'controlled_pharmacy';
    }

    function warehouseOfficer() {
      return activeUser() && role() == 'warehouse';
    }

    function departmentUser() {
      return activeUser() && role() == 'department';
    }

    function scopedStateUser() {
      return activeUser() && role() in ['department', 'outpatient_pharmacy_supervisor', 'warehouse', 'controlled_pharmacy', 'inpatient_supervisor', 'inpatient_pharmacy_supervisor', 'inpatient pharmacy supervisor', 'pharmacy_staff'];
    }

    function canReadScopedState(docId) {
      return (role() in ['department', 'outpatient_pharmacy_supervisor'] && canReadDepartmentState(docId))
        || (role() == 'controlled_pharmacy' && (docId.matches('^(controlled_.*|psychotropic_.*|narcotic_.*)$') || docId in ['departments', 'deleted_departments', 'custom_categories', 'facility_logo', 'theme', 'audit_log', 'user_activity_daily_v1']))
        || (role() == 'warehouse' && (docId.matches('^(controlled_warehouse|controlled_moves|controlled_pdf_receipts|warehouse_).*') || docId in ['departments', 'theme', 'audit_log', 'user_activity_daily_v1']))
        || (role() in ['inpatient_supervisor', 'inpatient_pharmacy_supervisor', 'inpatient pharmacy supervisor', 'pharmacy_staff'] && canReadPharmacyState(docId));
    }

    function canReadPharmacyState(docId) {
      return docId in ['departments', 'deleted_departments', 'custom_categories', 'requests', 'dept_notes', 'notes', 'crash_carts', 'crash_cart_reports', 'accountability_assignments_v2', 'accountability_usage_v2', 'accountability_receipts_v2', 'theme', 'facility_logo', 'pharmacy_category_config', 'pharmacy_department_announcements', 'pharmacy_department_expiry_rules', 'medication_freeze_rules_v3', 'medication_visibility_rules_v3', 'fulfillment_edit_settings_v1', 'req_windows', 'disp_slots', 'daily_limits_v2', 'weekly_limits_v2', 'monthly_limits', 'rate_limits_v2', 'request_count_limits_v1', 'request_hour_grids_v1', 'shelves_anesthesia', 'user_activity_daily_v1']
        || docId.matches('^(meds_|expiry_|shelves_|alerts_|inventory_integrity_|inventory_snapshot_index_).*');
    }

    // Same narrowed pattern as role() above: isolated early-return, verified
    // alone against the full firestore-rules test suite before being kept.
    function departmentId() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.get('deptId', '')
        : (profile().get('deptId', null) != null ? profile().get('deptId', null) : profile().get('departmentId', ''));
    }

    // Same narrowed pattern as role()/departmentId() above: isolated
    // early-return, verified alone against the full firestore-rules test
    // suite before being kept.
    function tenantId() {
      // Unauthenticated or inactive callers must never satisfy tenantId() == ''.
      // Returning a sentinel ensures every tenantId() == '' guard requires an
      // actual authenticated non-tenant profile, not just an absent session.
      return request.auth.token.get('role', null) != null
        ? (request.auth.token.get('active', false) == true ? request.auth.token.get('tenantId', '') : '__no_auth__')
        : (activeUser()
            ? (profile().get('tenantId', '') is string ? profile().get('tenantId', '') : '')
            : '__no_auth__');
    }

    function sameTenant(id) {
      return activeUser() && tenantId() != '' && tenantId() == id;
    }

    function sameUserTenant(userData) {
      return activeUser() && (
        userData.get('tenantId', '') is string
          ? userData.get('tenantId', '')
          : ''
      ) == tenantId();
    }

    // The original FloorStock installation predates tenant records.  Its
    // master profile and user directory therefore have no tenantId.  A Firestore
    // collection LIST cannot safely use resource.data to inspect every user,
    // which left that legitimate master unable to load the directory whenever
    // the callable path was temporarily unavailable.  Keep this narrowly
    // limited to the non-tenant legacy installation; tenant administrators
    // continue to use the server-side directory callable.
    function legacyMasterDirectoryReader() {
      return masterUser() && tenantId() == '';
    }

    function platformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    function tenantWritable(id) {
      return exists(/databases/$(database)/documents/tenants/$(id))
        && get(/databases/$(database)/documents/tenants/$(id)).data.status in ['active', 'trialing']
        && (
          get(/databases/$(database)/documents/tenants/$(id)).data.get('currentPeriodEnd', null) == null
          || get(/databases/$(database)/documents/tenants/$(id)).data.get('currentPeriodEnd', null) > request.time
        );
    }

    function tenantFeature(id, feature) {
      return feature in get(/databases/$(database)/documents/tenants/$(id)).data.features;
    }

    function stateFeatureAllowed(id, docId) {
      return (docId.matches('^crash_.*$') && tenantFeature(id, 'crash_cart'))
        || (docId.matches('^(controlled_.*|accountability_.*|psychotropic_.*|narcotic_.*)$') && tenantFeature(id, 'controlled'))
        || (docId.matches('^(requests|request_.*|fulfillment_edit_settings_v1|req_windows|disp_slots|daily_limits_v2|weekly_limits_v2|monthly_limits|rate_limits_v2)$') && tenantFeature(id, 'requests'))
        || (
          !docId.matches('^(crash_.*|controlled_.*|accountability_.*|psychotropic_.*|narcotic_.*|requests|request_.*|fulfillment_edit_settings_v1|req_windows|disp_slots|daily_limits_v2|weekly_limits_v2|monthly_limits|rate_limits_v2)$')
          && tenantFeature(id, 'inventory')
        );
    }

    function departmentLimitAllowed(id, docId) {
      return docId != 'departments'
        || get(/databases/$(database)/documents/tenants/$(id)).data.plan == 'enterprise'
        || (
          request.resource.data.value is list
          && (
            (get(/databases/$(database)/documents/tenants/$(id)).data.plan == 'starter' && request.resource.data.value.size() <= 10)
            || (get(/databases/$(database)/documents/tenants/$(id)).data.plan == 'professional' && request.resource.data.value.size() <= 50)
          )
        );
    }

    // ── Legacy-tenant parity helpers (Phase 7d) ──────────────────────────────
    // The original FloorStock installation predates the tenant subscription
    // system and therefore has no /tenants/{id} document to call
    // tenantWritable/stateFeatureAllowed/departmentLimitAllowed against.
    // These functions mirror those checks with the correct semantics for the
    // legacy deployment: the subscription is always considered active (direct-
    // contract model), all features are permanently enabled (no feature flags),
    // and there is no plan-based department cap.  Structural parity with the
    // tenant path is preserved so future restrictions can be added here.

    function legacyTenantWritable() {
      // Legacy uses activeUser() as the subscription gate — no expiry concept.
      return activeUser() && tenantId() == '';
    }

    function legacyFeatureAllowed(docId) {
      // All features permanently enabled for the legacy installation.
      // Signature mirrors stateFeatureAllowed(id, docId) for future alignment.
      return docId is string;
    }

    function legacyDepartmentLimitAllowed(docId) {
      // No plan-based department cap on the legacy installation.
      return true;
    }
    // ─────────────────────────────────────────────────────────────────────────

    function validStateShape() {
      return request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;
    }

    function validFulfillmentEditSettings(docId) {
      return docId != 'fulfillment_edit_settings_v1' || (
        request.resource.data.value is map
        && request.resource.data.value.keys().hasOnly(['hours', 'updatedAt', 'updatedBy', 'updatedById'])
        && request.resource.data.value.hours is number
        && request.resource.data.value.hours >= 0
        && request.resource.data.value.hours <= 8760
      );
    }

    function canReadDepartmentState(docId) {
      return docId in [
          'departments', 'deleted_departments', 'custom_categories',
          'daily_limits_v2', 'weekly_limits_v2', 'monthly_limits', 'rate_limits_v2',
          'req_windows', 'disp_slots', 'request_count_limits_v1', 'request_hour_grids_v1',
          'requests', 'dept_notes', 'notes', 'crash_carts', 'crash_cart_reports',
          'accountability_assignments_v2', 'accountability_usage_v2', 'accountability_receipts_v2',
          'fulfillment_edit_settings_v1',
          'theme', 'facility_logo',
          'pharmacy_category_config', 'pharmacy_department_announcements',
          'pharmacy_department_expiry_rules', 'medication_freeze_rules_v3',
          'medication_visibility_rules_v3', 'shelves_anesthesia',
          'controlled_catalog', 'user_activity_daily_v1'
        ]
        || docId == 'meds_' + departmentId()
        || docId == 'expiry_' + departmentId()
        || docId == 'shelves_' + departmentId()
        || docId == 'alerts_' + departmentId()
        || docId == 'inventory_integrity_' + departmentId()
        || docId == 'inventory_snapshot_index_' + departmentId()
        || docId == 'controlled_dept_list_' + departmentId()
        // Every department needs to read its own controlled_settings_ (head
        // nurse / controlled-medicines officer / pharmacy manager print
        // signatures) to print "My controlled list" — not just the
        // custodian who saved them. Shelf layout stays custodian-only since
        // it's an internal configuration detail, not something every
        // department print depends on.
        || docId == 'controlled_settings_' + departmentId()
        || (
          profile().get('controlledCustodian', false) == true
          && docId == 'controlled_dept_shelves_' + departmentId()
        );
    }

    function canWriteState(docId) {
      // Keep this decision compact. Re-evaluating activeUser()/profile() across every
      // role branch can exceed Firestore's 1,000-expression limit for department
      // custodians, especially on their controlled-department keys.
      let p = profile();
      let r = p.get('role', '');
      let dept = p.get('deptId', null) != null ? p.get('deptId', null) : p.get('departmentId', '');
      return (docId != 'fulfillment_edit_settings_v1' || masterUser()) && (
          r == 'department'
          && (
            docId in [
              // crash_cart_reports intentionally omitted: departments submit via
              // submitCrashCartReport Cloud Function (which also writes crash_carts
              // atomically). Direct browser writes to crash_cart_reports bypass
              // that atomic seal/cart-status update and are therefore disallowed.
              'requests', 'dept_notes', 'notes',
              'accountability_usage_v2', 'accountability_receipts_v2',
              'audit_log', 'theme', 'user_activity_daily_v1',
              'meds_' + dept, 'expiry_' + dept, 'shelves_' + dept,
              'alerts_' + dept,
              'inventory_integrity_' + dept,
              'inventory_snapshot_index_' + dept
            ]
            || docId.matches('^inventory_snapshot_' + dept + '_.*$')
            || (
              p.get('controlledCustodian', false) == true
              && docId in [
                'controlled_dept_list_' + dept,
                'controlled_dept_shelves_' + dept,
                'controlled_settings_' + dept
              ]
            )
          )
        )
        || (
          r != 'department'
          && (
            r in ['pharmacy', 'pharmacy_director']
            || (
              r in ['inpatient_supervisor', 'inpatient_pharmacy_supervisor', 'inpatient pharmacy supervisor']
              && docId.matches('^(crash_.*|accountability_.*|requests|notes|dept_notes|meds_.*|expiry_.*|shelves_.*|alerts_.*|request_analytics_archive|request_analytics_summary_v1|deleted_request_audit_v4|department_request_notifications_v1|pharmacy_.*|inventory_.*|inventory_name_merge_history|manual_medicine_merge_history_v1|similar_medicine_separations_v1|custom_categories|facility_logo|hidden_request_categories_v1|global_request_freeze_v2|medication_(visibility|freeze)_rules_v3|audit_log|theme|user_activity_daily_v1)$')
            )
            || (
              r == 'outpatient_pharmacy_supervisor'
              && docId.matches('^(crash_carts|crash_cart_reports|requests|notes|dept_notes|request_analytics_archive|request_analytics_summary_v1|audit_log|theme|user_activity_daily_v1)$')
            )
            || (
              r == 'pharmacy_staff'
              && docId.matches('^(crash_carts|crash_cart_reports|accountability_.*|requests|notes|dept_notes|request_analytics_archive|request_analytics_summary_v1|audit_log|theme|user_activity_daily_v1)$')
            )
            || (
              r == 'controlled_pharmacy'
              && docId.matches('^(controlled_.*|accountability_.*|psychotropic_.*|narcotic_.*|audit_log|theme|user_activity_daily_v1)$')
            )
            || (
              r == 'warehouse'
              && docId.matches('^(controlled_warehouse|controlled_moves|controlled_pdf_receipts|audit_log|theme|user_activity_daily_v1)$')
            )
          )
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || ((masterUser() || pharmacyDirector()) && sameUserTenant(resource.data))
        || platformAdmin()
      );
      allow list: if platformAdmin()
        || legacyMasterDirectoryReader()
        || ((masterUser() || pharmacyDirector()) && sameUserTenant(resource.data));
      allow create, update, delete: if false;
    }

    match /tenants/{tenant}/state/{docId} {
      allow get: if sameTenant(tenant) && (!scopedStateUser() || canReadScopedState(docId));
      allow list: if sameTenant(tenant) && !scopedStateUser();
      allow create, update: if sameTenant(tenant)
        && tenantWritable(tenant)
        && stateFeatureAllowed(tenant, docId)
        && departmentLimitAllowed(tenant, docId)
        && canWriteState(docId)
        && validStateShape()
        && validFulfillmentEditSettings(docId);
      allow delete: if sameTenant(tenant) && tenantWritable(tenant) && (
        masterUser() || pharmacyDirector()
        || (inpatientSupervisor() && docId.matches('^inventory_snapshot_.*$'))
        || (departmentUser() && docId.matches('^inventory_snapshot_' + departmentId() + '_.*$'))
      );
    }

    match /tenants/{tenant} {
      allow get: if sameTenant(tenant) || platformAdmin();
      allow list: if platformAdmin();
      allow create, update, delete: if false;

      // Individual crash cart report documents.  All writes are via Cloud
      // Functions (admin SDK) — the rules here gate client-side reads only.
      match /crash_cart_reports/{reportId} {
        allow get: if sameTenant(tenant);
        allow list: if sameTenant(tenant) && (
          !scopedStateUser()
          || departmentUser()
          || role() in ['inpatient_supervisor', 'inpatient_pharmacy_supervisor', 'inpatient pharmacy supervisor', 'pharmacy_staff', 'outpatient_pharmacy_supervisor']
        );
        allow create, update, delete: if false;
      }

      match /public_expiry/{docId} {
        allow get: if true;
        allow list: if sameTenant(tenant) && masterUser();
        allow create, update: if sameTenant(tenant) && tenantWritable(tenant) && tenantFeature(tenant, 'expiry') && (
          masterUser() || pharmacyDirector() || inpatientSupervisor() || (departmentUser() && docId == departmentId())
        );
        allow delete: if sameTenant(tenant) && tenantWritable(tenant) && (masterUser() || pharmacyDirector());
      }

      match /public_controlled_expiry/{docId} {
        allow get: if true;
        allow list: if sameTenant(tenant) && masterUser();
        allow create, update: if sameTenant(tenant) && tenantWritable(tenant) && (
          ((docId.matches('^crash_.*$') && tenantFeature(tenant, 'crash_cart')) ||
           (!docId.matches('^crash_.*$') && tenantFeature(tenant, 'controlled'))) && (
          masterUser() || pharmacyDirector() || inpatientSupervisor()
          || (pharmacyStaff() && docId.matches('^crash_.*$'))
          || controlledOfficer() || warehouseOfficer()
          || (departmentUser() && docId == departmentId())
        ));
        allow delete: if sameTenant(tenant) && tenantWritable(tenant) && (masterUser() || pharmacyDirector());
      }
    }

    // Department sessions use explicit document reads. Crash Cart state is read so
    // the client can retain only the authenticated department's carts and reports.
    // Department sessions use explicit document reads. Crash Cart state is read so
    // the client can retain only the authenticated department's carts and reports.
    match /floorstock_state/{docId} {
      allow get: if legacyTenantWritable() && (
        !scopedStateUser() || canReadScopedState(docId)
      );
      allow list: if legacyTenantWritable() && !scopedStateUser();
      // Structurally mirrors tenants/{id}/state/{docId} create/update:
      //   legacyTenantWritable()      ≡ sameTenant(t) && tenantWritable(t)
      //   legacyFeatureAllowed(docId) ≡ stateFeatureAllowed(t, docId)
      //   legacyDepartmentLimitAllowed(docId) ≡ departmentLimitAllowed(t, docId)
      allow create, update: if legacyTenantWritable()
        && legacyFeatureAllowed(docId)
        && legacyDepartmentLimitAllowed(docId)
        && canWriteState(docId)
        && (docId != 'fulfillment_edit_settings_v1' || (role() in ['pharmacy', 'pharmacy_director'] && masterClaim()))
        && validStateShape()
        && validFulfillmentEditSettings(docId);
      allow delete: if legacyTenantWritable() && (masterUser() || pharmacyDirector()
        || (inpatientSupervisor() && docId.matches('^inventory_snapshot_.*$'))
        || (departmentUser() && docId.matches('^inventory_snapshot_' + departmentId() + '_.*$')));
    }

    match /public_expiry/{docId} {
      allow get: if true;
      allow list: if tenantId() == '' && masterUser();
      allow create, update: if activeUser() && tenantId() == '' && (
        masterUser()
        || pharmacyDirector()
        || inpatientSupervisor()
        || (departmentUser() && docId == departmentId())
      );
      allow delete: if tenantId() == '' && (masterUser() || pharmacyDirector());
    }

    match /public_controlled_expiry/{docId} {
      allow get: if true;
      allow list: if tenantId() == '' && masterUser();
      allow create, update: if activeUser() && tenantId() == '' && (
        masterUser()
        || pharmacyDirector()
        || inpatientSupervisor()
        || (pharmacyStaff() && docId.matches('^crash_.*$'))
        || controlledOfficer()
        || warehouseOfficer()
        || (departmentUser() && docId == departmentId())
      );
      allow delete: if tenantId() == '' && (masterUser() || pharmacyDirector());
    }

    match /public_crash_carts/{docId} {
      allow read: if false;
      allow create, update, delete: if tenantId() == '' && masterUser();
    }

    // Legacy (non-tenant) crash cart report collection.  All writes are via
    // Cloud Functions (admin SDK) — rules here gate client reads only.
    match /crash_cart_reports_v2/{reportId} {
      allow get: if activeUser() && tenantId() == '';
      allow list: if activeUser() && tenantId() == '';
      allow create, update, delete: if false;
    }

    match /floorstock_backups/{uid}/snapshots/{snapshotId} {
      allow read, create, update, delete: if masterUser()
        && request.auth.uid == uid;

      match /chunks/{chunkId} {
        allow read, create, update, delete: if masterUser()
          && request.auth.uid == uid;
      }
    }

    // Raw temporary handover token hashes are server-only. Public confirmation
    // goes through Cloud Functions and never through direct Firestore access.
    match /accountability_handover_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if tenantId() == '' && (masterUser() || pharmacyDirector());
      allow write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
