{
  "name": "asdhealth-floorstock",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:modules": "node tools/verify_modules.mjs && node tools/verify_unresolved_names.mjs && node tools/verify_action_handler_scopes.mjs",
    "verify": "python3 verify_repo.py && node tools/generate_upkeep_policy.mjs --check && npm run verify:modules && npm run audit:duplicates",
    "audit:architecture": "node tools/audit_architecture.mjs",
    "audit:dead": "node tools/audit_dead_code.mjs --strict", "audit:duplicates": "node tools/audit_duplicate_helpers.mjs --strict",
    "audit:firebase": "node tools/audit_firebase_exports.mjs",
    "test:ui": "node tools/run_ui_tests.mjs",
    "test:browser": "playwright test",
    "test:rules:emulator": "node --test --test-concurrency=1 tests/firestore-rules/firestore.rules.test.js tests/firestore-rules/storage.rules.test.js",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-floorstock-rules --config firebase.json \"npm run test:rules:emulator\"",
    "test": "npm run verify && npm run test:ui && npm run test:functions && npm run test:browser && npm run test:rules && npm run test:cf",
    "test:functions": "npm --prefix functions test",
    "stamp": "node tools/stamp_module_hashes.mjs && node tools/mirror_root_index.mjs",
    "test:cf": "firebase emulators:exec --only functions,firestore,auth --project demo-floorstock-cf --config firebase.json \"node tests/integration/accountability-handover.cf.mjs\"",
    "test:close": "firebase emulators:exec --only functions,firestore,auth --project demo-floorstock-cf --config firebase.json \"node tests/integration/crash-cart-close.cf.mjs\"",
    "test:upkeep": "firebase emulators:exec --only functions,firestore,auth --project demo-floorstock-cf --config firebase.json \"node tests/integration/scheduled-upkeep.cf.mjs\""
  },
  "dependencies": {
    "@vercel/edge": "1.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "^1.61.1",
    "acorn": "8.15.0",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  }
}
